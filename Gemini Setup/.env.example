# Shared by every episode and bonus folder in this Setup.
# Copy this file to ".env" (once, here at the Setup root) and fill in your values.
# Get a free Gemini API key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-key-here
GEMINI_EMBED_MODEL=gemini-embedding-001
GEMINI_EMBED_DIM=768
GEMINI_CHAT_MODEL=gemini-3.8-flash

DB_HOST=127.0.0.1
DB_NAME=nimbus
DB_USER=root
DB_PASS=

# Only needed for bonus-01/bonus-02 (Local News RAG).
# Free GNews key (100 req/day): https://gnews.io/register
GNEWS_API_KEY=your-gnews-key-here
