# Shared by every episode and bonus folder in this Setup.
# Copy this file to ".env" (once, here at the Setup root) and fill in your values.
OPENAI_API_KEY=sk-your-key-here
OPENAI_EMBED_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4o-mini

DB_HOST=127.0.0.1
DB_NAME=nimbus
DB_USER=root
DB_PASS=

# Only needed for bonus-01/bonus-02 (Local News RAG).
# Get a free key at https://gnews.io/register  (100 requests/day)
GNEWS_API_KEY=your-gnews-key-here
